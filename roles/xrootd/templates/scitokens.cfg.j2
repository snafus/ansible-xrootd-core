# SciTokens configuration for XRootD.
# Managed by Ansible — do not edit manually.
#
# Token requirements (WLCG JWT Profile v1.0):
#   - 'iss' claim must match an [Issuer] block below
#   - 'aud' claim must match the audience value (or include wlcg.cern.ch/jwt/v1/any)
#   - 'scope' must include storage.read, storage.modify, storage.create, or
#     storage.stage as appropriate for the requested operation
#   - 'sub' claim is used for user mapping when map_subject = true
#   - 'wlcg.groups' claim is passed through to the authz layer (Authfile/ACC)

[Global]
# onmissing = passthrough: requests with no token fall through to the next
#   auth layer (X.509, Macaroon, Authfile).  Use 'deny' to require a token.
onmissing = {{ xrootd_scitokens_onmissing }}

# audience: must match the 'aud' claim in the JWT.
#   Production sites should use their own endpoint URL, not the any-audience
#   sentinel, to prevent token reuse across services.
audience = {{ xrootd_scitokens_audience }}

{% for issuer in xrootd_scitokens_issuers %}
[Issuer {{ issuer.name }}]
# Issuer URL — must match the 'iss' claim exactly (trailing slash matters)
issuer = {{ issuer.url }}

# base_path: only tokens whose path scope is a sub-path of this value are
# accepted.  Typically one of the paths in xrootd_exports.
base_path = {{ issuer.base_path | default('/') }}

# map_subject: use the JWT 'sub' claim as the local Unix username.
# Requires a consistent sub claim from the issuer (e.g. INDIGO IAM UUID).
map_subject = {{ issuer.map_subject | default('false') | string | lower }}

# default_user: Unix user for file operations when map_subject is false
# or the sub claim has no local mapping.
default_user = {{ issuer.default_user | default('xrootd') }}
{% if issuer.name_mapfile is defined and issuer.name_mapfile %}

# name_mapfile: maps JWT 'sub' values to local Unix usernames, one per line:
#   <sub-value> <unix-username>
name_mapfile = {{ issuer.name_mapfile }}
{% endif %}

{% endfor %}
